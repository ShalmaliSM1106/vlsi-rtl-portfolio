// Program 4: AND/OR/XOR, SW/LW, load-use stalls, R0 is not writable
620C  // 0: ADDI R1,R0,12
640A  // 1: ADDI R2,R0,10
3650  // 2: AND  R3,R1,R2     R3 = 8
4850  // 3: OR   R4,R1,R2     R4 = 14
5A50  // 4: XOR  R5,R1,R2     R5 = 6
8604  // 5: SW   R3,4(R0)     mem[4] = 8
8805  // 6: SW   R4,5(R0)     mem[5] = 14
7C04  // 7: LW   R6,4(R0)     R6 = 8
1FA0  // 8: ADD  R7,R6,R4     R7 = 22 (load-use -> stall)
7205  // 9: LW   R1,5(R0)     R1 = 14
25C8  // 10: SUB R2,R7,R1     R2 = 8  (load-use -> stall)
6009  // 11: ADDI R0,R0,9     must NOT change R0
F000  // 12: HALT
