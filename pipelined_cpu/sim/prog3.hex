// Program 3: not-taken BEQ, taken BEQ and JMP; instructions after them must be flushed
6201  // 0: ADDI R1,R0,1
6401  // 1: ADDI R2,R0,1
9205  // 2: BEQ  R1,R0,+5     not taken (1 != 0)
6603  // 3: ADDI R3,R0,3      executes (R3 = 3)
9283  // 4: BEQ  R1,R2,+3     taken -> 4+1+3 = 8
681F  // 5: ADDI R4,R0,31     flushed (was in ID)
6A1F  // 6: ADDI R5,R0,31     flushed (was in IF)
6A1F  // 7: ADDI R5,R0,31     skipped
6C07  // 8: ADDI R6,R0,7      branch target (R6 = 7)
A00B  // 9: JMP  11
6E1F  // 10: ADDI R7,R0,31    flushed
F000  // 11: HALT
